# 複製成 .env，填好之後用 systemd（見 deploy/executor.service）或
# `node --env-file=.env src/server.js` 啟動。.env 本身絕對不要提交進 git
# （.gitignore 已經排除），也不要貼到任何聊天視窗或截圖。

# ── 監聽設定 ──────────────────────────────────────────────────────────────
PORT=8787
# 只在信任的反向代理（例如自己架的 nginx/caddy）後面才需要設成 true，
# 讓 Executor 從 X-Forwarded-For 讀真正的來源 IP 做 log；沒有反向代理、
# Node 直接對外監聽就維持 false。
TRUST_PROXY=false

# ── Bybit API 金鑰（只放在這裡，Cloudflare Worker 完全不會拿到）──────────
BYBIT_API_KEY=
BYBIT_API_SECRET=

# 絕對不要改成 true，除非你非常清楚自己在做什麼、而且已經有其他額外的
# 人工確認機制——這是「用真錢下單」的開關，Executor 程式碼本身不會、
# 也不允許被任何請求參數自動改成 true。
LIVE_TRADING=false

# ── Cloudflare Worker ↔ Executor 的雙向驗證 ───────────────────────────────
# 32 字元以上的隨機字串，跟 Worker 那邊的 EXECUTOR_HMAC_SECRET 要完全一樣。
# 產生方式：openssl rand -hex 32
EXECUTOR_HMAC_SECRET=

# ── Discord 告警（選用但強烈建議設定）─────────────────────────────────────
# 可以跟 Worker 用同一個 webhook，也可以另外開一個專門看 Executor 狀態的頻道。
DISCORD_WEBHOOK_URL=

# ── 安全機制 ──────────────────────────────────────────────────────────────
# 每隔幾分鐘自動重新做一次健康檢查（查 Bybit 連得到連不到）；健康檢查
# 出現 403／連不到就自動觸發緊急停止，直到下一次健康檢查恢復正常。
HEALTH_CHECK_INTERVAL_MIN=5
# 請求時間戳超過這個秒數就拒絕（防重放攻擊）
REQUEST_MAX_AGE_SEC=30
# 打 Bybit API 的逾時秒數
BYBIT_TIMEOUT_SEC=15
