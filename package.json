{
  "name": "smc-crypto-terminal",
  "version": "1.0.0",
  "description": "SMC Crypto Terminal — 以 Smart Money Concepts 分析加密貨幣市場的專業級網頁終端機",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:single": "node scripts/build-single.mjs",
    "build:preview": "node scripts/build-single.mjs dist/preview.html --artifact",
    "check": "node --check src/app.js",
    "measure-edge": "node scripts/measure-edge.mjs --source null --series 500",
    "time-to-target": "node scripts/time-to-target.mjs --runs 20000 --md docs/time-to-target.md",
    "hundred-x": "node scripts/hundred-x.mjs --runs 100000 --md docs/hundred-x.md",
    "backtest": "node scripts/microlot-montecarlo.mjs --runs 10000 --json docs/microlot-backtest.json --md docs/microlot-backtest.md"
  },
  "keywords": ["smc", "smart-money-concepts", "ict", "crypto", "trading", "order-block", "fvg", "liquidity", "market-structure"],
  "license": "MIT",
  "private": true,
  "engines": { "node": ">=18" }
}
